# Скопируйте в /etc/led-list/api.env на сервере (см. DEPLOY.md) и заполните.
# Для локальной разработки не обязателен — без него используется тестовый секрет.

# Обязателен в продакшене (NODE_ENV=production) — процесс не запустится без него.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Порт и адрес, на котором слушает API. 127.0.0.1 — снаружи сервер виден только через nginx.
PORT=3001
HOST=127.0.0.1

NODE_ENV=production

# Учётная запись администратора — используется ТОЛЬКО при создании новой базы.
# Если не задать, пароль сгенерируется случайным и один раз напечатается в лог сервера.
# ADMIN_EMAIL=info@novayaera.com
# ADMIN_NAME=Анзор Матаев
# ADMIN_PASSWORD=

# Необязательно: фирменный шрифт для PDF-прайса (Mazzard). Если его нет на сервере —
# автоматически используется встроенный PT Sans, ничего дополнительно настраивать не нужно.
# PDF_FONT_DIR=/etc/led-list/fonts
# PDF_FONT_FAMILY=MazzardM
